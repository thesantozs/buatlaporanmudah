                return new Promise((resolve, reject) => {
                    const request = indexedDB.open('PkhReportDB', 2);
                    request.onupgradeneeded = (e) => {
                        const dbInst = e.target.result;
                        if (!dbInst.objectStoreNames.contains('identitas')) {
                            dbInst.createObjectStore('identitas');
                        }
                        if (!dbInst.objectStoreNames.contains('profiles')) {
                            dbInst.createObjectStore('profiles', { keyPath: 'id' });
                        }
                        if (!dbInst.objectStoreNames.contains('reports')) {
                            const repStore = dbInst.createObjectStore('reports', { keyPath: 'id' });
                            repStore.createIndex('tanggal_laporan', 'tanggal_laporan', { unique: false });
                            repStore.createIndex('rhk_id', 'rhk_id', { unique: false });
                        }
                        if (!dbInst.objectStoreNames.contains('settings')) {
                            dbInst.createObjectStore('settings', { keyPath: 'key' });
                        }
                    };
                    request.onsuccess = (e) => {
                        this.dbInstance = e.target.result;
                        resolve(this.dbInstance);
                    };
                    request.onerror = (e) => reject(e);
                });
            },
            async getAllProfiles() {
                if (!this.dbInstance) await this.init();
                return new Promise((resolve) => {
                    const tx = this.dbInstance.transaction('profiles', 'readonly');
                    const req = tx.objectStore('profiles').getAll();
                    req.onsuccess = () => resolve(req.result || []);
                    req.onerror = () => resolve([]);

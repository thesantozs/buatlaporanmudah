    <script>
        // AI Gemini Integration Helper with Exponential Backoff
        async function callGeminiAPI(userQuery, systemPrompt) {
            const apiKey = "";
            const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

            const payload = {
                contents: [{ parts: [{ text: userQuery }] }],
                systemInstruction: {
                    parts: [{ text: systemPrompt }]
                },
                generationConfig: {
                    responseMimeType: "application/json",
                    responseSchema: {
                        type: "OBJECT",
                        properties: {
                            "uraian": { "type": "STRING" },
                            "hasil_dicapai": { "type": "STRING" },
                            "simpulan_saran": { "type": "STRING" },
                            "umum": { "type": "STRING" },
                            "maksud_tujuan": { "type": "STRING" },
                            "ruang_lingkup": { "type": "STRING" },
                            "dasar": { "type": "STRING" },
                            "waktu_pelaksanaan": { "type": "STRING" },
                            "pelaksanaan_kegiatan": { "type": "STRING" }
                        },
                        required: ["uraian", "hasil_dicapai", "simpulan_saran"]
                    }
                }
            };

            let retries = 3;
            let delay = 1000;

            for (let i = 0; i < retries; i++) {
                try {
                    const response = await fetch(apiUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });

                    if (!response.ok) throw new Error(`HTTP Error ${response.status}`);

                    const result = await response.json();
                    const text = result?.candidates?.[0]?.content?.parts?.[0]?.text;
                    if (text) {
                        return JSON.parse(text);
                    }
                } catch (err) {
                    if (i === retries - 1) throw err;
                    await new Promise(res => setTimeout(res, delay));
                    delay *= 2;
                }
            }
            throw new Error("Gagal menghubungkan ke layanan AI Gemini");
        }

        function openAIAssistantModal() {
            document.getElementById('modal-ai-assistant').classList.remove('hidden');

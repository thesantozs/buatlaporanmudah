        async function applyFilters() {
            const searchVal = document.getElementById('filter-search').value.toLowerCase().trim();
            const dateStart = document.getElementById('filter-date-start').value;
            const dateEnd = document.getElementById('filter-date-end').value;
            const rhkVal = document.getElementById('filter-rhk').value;
            const monthVal = document.getElementById('filter-month').value;

            let reports = await db.getAllReports();

            reports = reports.filter(r => {
                if (searchVal) {
                    const matchUraian = r.uraian.toLowerCase().includes(searchVal);
                    const matchLokasi = r.lokasi.toLowerCase().includes(searchVal);
                    const matchPilihan = r.pilihan_laporan.toLowerCase().includes(searchVal);
                    if (!matchUraian && !matchLokasi && !matchPilihan) return false;
                }

                if (dateStart && r.tanggal_laporan < dateStart) return false;
                if (dateEnd && r.tanggal_laporan > dateEnd) return false;
                if (rhkVal && r.rhk_id != rhkVal) return false;

                if (monthVal) {
                    const parts = r.tanggal_laporan.split('-');
                    if (parts[1] !== monthVal) return false;
                }

                return true;
            });

            renderReportsTable(reports);
        }

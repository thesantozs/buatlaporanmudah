        async function generateMonthlyRekapView() {
            const mVal = document.getElementById('rekap-month-select').value;
            const yVal = document.getElementById('rekap-year-input').value;

            const monthNames = ["Januari", "Februari", "Maret", "April", "Mei", "Juni", "Juli", "Agustus", "September", "Oktober", "November", "Desember"];
            document.getElementById('rekap-title-label').textContent = `${monthNames[parseInt(mVal)-1]} ${yVal}`;

            const allReports = await db.getAllReports();
            const monthlyFiltered = allReports.filter(r => {
                const parts = r.tanggal_laporan.split('-');
                return parts[0] === yVal && parts[1] === mVal;
            });

            monthlyFiltered.sort((a,b) => new Date(a.tanggal_laporan) - new Date(b.tanggal_laporan));

            const rhkCounts = {};
            MASTER_RHK.forEach(r => rhkCounts[r.id] = 0);
            monthlyFiltered.forEach(r => {
                if (rhkCounts[r.rhk_id] !== undefined) rhkCounts[r.rhk_id]++;
            });

            const rhkListContainer = document.getElementById('rekap-rhk-list');
            rhkListContainer.innerHTML = '';

            MASTER_RHK.forEach(r => {
                const card = document.createElement('div');
                card.className = 'bg-slate-50 border border-slate-200 rounded-xl p-3 flex justify-between items-center';
                card.innerHTML = `
                    <div>
                        <span class="bg-blue-100 text-kemensos-navy text-[10px] font-bold px-2 py-0.5 rounded">RHK ${r.id}</span>
                        <p class="text-xs font-medium text-slate-700 mt-1 line-clamp-1">${r.desc}</p>
                    </div>
                    <span class="text-base font-bold bg-white px-3 py-1 rounded-lg border border-slate-200 text-kemensos-navy">${rhkCounts[r.id]}</span>
                `;
                rhkListContainer.appendChild(card);
            });

            const tbody = document.getElementById('rekap-table-body');
            tbody.innerHTML = '';

            if (monthlyFiltered.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="p-6 text-center text-slate-400">Tidak ada kegiatan tercatat pada bulan ${monthNames[parseInt(mVal)-1]} ${yVal}.</td></tr>`;
                return;
            }

            monthlyFiltered.forEach((rpt, idx) => {
                const tr = document.createElement('tr');
                tr.className = 'hover:bg-slate-50';
                tr.innerHTML = `
                    <td class="p-3 text-center text-slate-500">${idx+1}</td>
                    <td class="p-3 font-semibold">${formatDateID(rpt.tanggal_laporan)}</td>
                    <td class="p-3 text-center"><span class="bg-blue-100 text-kemensos-navy text-[10px] font-bold px-2 py-0.5 rounded">RHK ${rpt.rhk_id}</span></td>
                    <td class="p-3">
                        <div class="font-semibold text-slate-800">${escapeHtml(rpt.pilihan_laporan)}</div>
                        <div class="text-slate-500 line-clamp-2 text-[11px]">${escapeHtml(rpt.uraian)}</div>
                    </td>
                    <td class="p-3">${escapeHtml(rpt.lokasi)}</td>
                    <td class="p-3 text-center font-bold text-blue-700">${rpt.photos ? rpt.photos.length : 0}</td>
                `;
                tbody.appendChild(tr);
            });
        }
        window.generateMonthlyRekapView = generateMonthlyRekapView;

        async function downloadRekapPDF() {
            const mVal = document.getElementById('rekap-month-select').value;
            const yVal = document.getElementById('rekap-year-input').value;
            const monthNames = ["Januari", "Februari", "Maret", "April", "Mei", "Juni", "Juli", "Agustus", "September", "Oktober", "November", "Desember"];

            const allReports = await db.getAllReports();
            const monthlyFiltered = allReports.filter(r => {
                const parts = r.tanggal_laporan.split('-');
                return parts[0] === yVal && parts[1] === mVal;
            });

            if (monthlyFiltered.length === 0) {
                showToast(`Tidak ada data laporan untuk bulan ${monthNames[parseInt(mVal)-1]} ${yVal}`, 'error');
                return;
            }

            monthlyFiltered.sort((a,b) => new Date(a.tanggal_laporan) - new Date(b.tanggal_laporan));
            const profile = await db.getActiveProfile() || {};

            const { jsPDF } = window.jspdf;
            const doc = new jsPDF({ orientation: 'landscape', unit: 'mm', format: 'a4' });
            const pageWidth = doc.internal.pageSize.getWidth();
            const margin = 12;

            doc.setFont("helvetica", "bold");
            doc.setFontSize(12);
            doc.text(`REKAPITULASI LAPORAN HARIAN PENDAMPING PKH`, pageWidth / 2, 15, { align: "center" });
            doc.setFontSize(10);
            doc.text(`PERIODE: BULAN ${monthNames[parseInt(mVal)-1].toUpperCase()} TAHUN ${yVal}`, pageWidth / 2, 21, { align: "center" });

            doc.setLineWidth(0.5);
            doc.line(margin, 25, pageWidth - margin, 25);

            doc.setFontSize(8);
            doc.setFont("helvetica", "normal");
            doc.text(`Nama Pendamping : ${profile.nama || '-'}`, margin, 30);
            doc.text(`Kecamatan / Kab : ${profile.kecamatan || '-'} / ${profile.kabupaten || '-'}`, 150, 30);

            const tableRows = monthlyFiltered.map((r, idx) => [
                idx + 1,
                formatDateID(r.tanggal_laporan),
                `RHK ${r.rhk_id}`,
                r.pilihan_laporan,
                r.uraian,
                r.lokasi,
                r.photos ? `${r.photos.length} Foto` : '0'
            ]);

            doc.autoTable({
                startY: 34,
                head: [['NO', 'TANGGAL', 'RHK', 'PILIHAN LAPORAN HARIAN', 'URAIAN KEGIATAN', 'LOKASI', 'DOKUMENTASI']],
                body: tableRows,
                theme: 'grid',
                headStyles: { fillColor: [0, 51, 102], textColor: 255, fontSize: 8, fontStyle: 'bold', halign: 'center' },
                bodyStyles: { fontSize: 8 },
                columnStyles: {
                    0: { cellWidth: 10, halign: 'center' },
                    1: { cellWidth: 25, halign: 'center' },
                    2: { cellWidth: 18, halign: 'center' },
                    3: { cellWidth: 65 },
                    4: { cellWidth: 110 },
                    5: { cellWidth: 30 },
                    6: { cellWidth: 20, halign: 'center' }
                },
                margin: { left: margin, right: margin }
            });

            const pageCount = doc.internal.getNumberOfPages();
            for (let i = 1; i <= pageCount; i++) {
                doc.setPage(i);
                doc.setFontSize(8);
                doc.text(`Halaman ${i} dari ${pageCount}`, pageWidth - margin, 200, { align: 'right' });
            }

            doc.save(`Rekap_PKH_${mVal}_${yVal}.pdf`);
            showToast('PDF Rekap Bulanan berhasil diunduh!');
        }
        window.downloadRekapPDF = downloadRekapPDF;

        // Export & Backup Engine
        async function exportToExcel() {
            const allReports = await db.getAllReports();
            if (allReports.length === 0) {
                showToast('Tidak ada data untuk diekspor', 'error');
                return;
            }

            const exportData = allReports.map((r, idx) => ({
                "No": idx + 1,
                "Nomor Laporan": r.nomor_laporan,
                "Tanggal Kegiatan": formatDateID(r.tanggal_laporan),
                "Nomor RHK": `RHK ${r.rhk_id}`,
                "Pilihan Laporan Harian": r.pilihan_laporan,
                "Uraian / Realisasi Kegiatan": r.uraian,
                "Hasil yang Dicapai": r.hasil_dicapai || "",
                "Simpulan dan Saran": r.simpulan_saran || "",
                "Lokasi Kegiatan": r.lokasi,
                "Keterangan": r.keterangan || "",
                "Jumlah Foto": r.photos ? r.photos.length : 0,
                "Waktu System Saved": r.created_at
            }));

            const worksheet = XLSX.utils.json_to_sheet(exportData);
            const workbook = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(workbook, worksheet, "Laporan_Harian_PKH");

            XLSX.writeFile(workbook, `Data_Laporan_PKH_${new Date().toISOString().split('T')[0]}.xlsx`);
            showToast('Data berhasil diekspor ke Excel!');
        }
        window.exportToExcel = exportToExcel;

        async function backupJSON() {
            const reports = await db.getAllReports();
            const profiles = await db.getAllProfiles();
            const activeProf = await db.getActiveProfile();

            const backupObj = {
                version: "2.0",
                export_date: new Date().toISOString(),
                active_profile_id: activeProf ? activeProf.id : null,
                profiles: profiles,
                reports: reports
            };

            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(backupObj));
            const downloadAnchor = document.createElement('a');
            downloadAnchor.setAttribute("href", dataStr);
            downloadAnchor.setAttribute("download", `Backup_PKH_${new Date().toISOString().split('T')[0]}.json`);
            document.body.appendChild(downloadAnchor);
            downloadAnchor.click();
            downloadAnchor.remove();

            showToast('Backup JSON berhasil diunduh!');
        }
        window.backupJSON = backupJSON;

        function restoreJSON(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = async (e) => {
                try {
                    const parsed = JSON.parse(e.target.result);
                    if (parsed.profiles && Array.isArray(parsed.profiles)) {
                        for (const prof of parsed.profiles) {
                            await db.saveProfile(prof);
                        }
                    } else if (parsed.identitas) {
                        const legacyProf = { ...parsed.identitas, id: `PROF-LEGACY` };
                        await db.saveProfile(legacyProf);
                    }

                    if (parsed.active_profile_id) {
                        await db.setActiveProfileId(parsed.active_profile_id);
                    }

                    if (parsed.reports && Array.isArray(parsed.reports)) {
                        await db.bulkSaveReports(parsed.reports);
                    }

                    showToast('Data berhasil dipulihkan dari backup!');
                    await refreshHeaderUser();
                    await loadProfilesManager();
                    refreshDashboard();
                    event.target.value = '';
                } catch (err) {
                    showToast('File backup JSON tidak valid', 'error');
                }
            };
            reader.readAsText(file);
        }
        window.restoreJSON = restoreJSON;


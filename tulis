<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aplikasi Laporan Harian Pendamping PKH</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Font Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- jsPDF & AutoTable -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
    <!-- SheetJS (XLSX) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        kemensos: {
                            navy: '#003366',
                            navyDark: '#002244',
                            gold: '#d4af37',
                            goldHover: '#b89628',
                            green: '#16a34a',
                            greenDark: '#15803d'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f4f6f9; }
        .hide-scrollbar::-webkit-scrollbar { display: none; }
        .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 antialiased min-h-screen flex flex-col pb-20 md:pb-6">

    <header class="bg-kemensos-navy text-white shadow-lg sticky top-0 z-30 border-b-2 border-kemensos-gold">
        <div class="max-w-7xl mx-auto px-4 py-3 flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <div class="bg-white p-1.5 rounded-lg shadow-sm">
                    <i class="fa-solid fa-hands-holding-child text-kemensos-navy text-xl md:text-2xl"></i>
                </div>
                <div>
                    <h1 class="text-base md:text-xl font-bold tracking-tight leading-tight flex items-center gap-2">
                        LAPORAN HARIAN PKH
                        <span class="bg-kemensos-gold text-kemensos-navy font-extrabold text-[10px] px-2 py-0.5 rounded hidden sm:inline-block">KEMENSOS RI</span>
                    </h1>
                    <p class="text-xs text-slate-200 hidden sm:block">Sistem Informasi Kegiatan Pendamping Program Keluarga Harapan</p>
                </div>
            </div>
            <div class="flex items-center space-x-2">
                <button onclick="window.navTo('identitas')" class="flex items-center space-x-2 bg-kemensos-navyDark hover:bg-blue-950 text-white text-xs md:text-sm py-1.5 px-3 rounded-lg transition shadow-sm border border-kemensos-gold/40">
                    <i class="fa-solid fa-id-card text-kemensos-gold"></i>
                    <span id="header-user-name" class="hidden md:inline font-medium">Pendamping PKH</span>
                </button>
            </div>
        </div>
    </header>

    <nav class="bg-white border-b border-slate-200 hidden md:block shadow-sm sticky top-[57px] z-20">
        <div class="max-w-7xl mx-auto px-4 flex space-x-1">
            <button onclick="window.navTo('dashboard')" id="nav-dashboard" class="nav-btn py-3 px-4 font-semibold text-sm border-b-2 border-kemensos-navy text-kemensos-navy flex items-center gap-2">
                <i class="fa-solid fa-chart-pie text-kemensos-gold"></i> Dashboard
            </button>
            <button onclick="window.navTo('tambah')" id="nav-tambah" class="nav-btn py-3 px-4 font-medium text-sm text-slate-600 hover:text-kemensos-navy border-b-2 border-transparent flex items-center gap-2">
                <i class="fa-solid fa-circle-plus"></i> Tambah Laporan
            </button>
            <button onclick="window.navTo('data')" id="nav-data" class="nav-btn py-3 px-4 font-medium text-sm text-slate-600 hover:text-kemensos-navy border-b-2 border-transparent flex items-center gap-2">
                <i class="fa-solid fa-list-check"></i> Data Laporan
            </button>
            <button onclick="window.navTo('rekap')" id="nav-rekap" class="nav-btn py-3 px-4 font-medium text-sm text-slate-600 hover:text-kemensos-navy border-b-2 border-transparent flex items-center gap-2">
                <i class="fa-solid fa-calendar-days"></i> Rekap Bulanan
            </button>
            <button onclick="window.navTo('identitas')" id="nav-identitas" class="nav-btn py-3 px-4 font-medium text-sm text-slate-600 hover:text-kemensos-navy border-b-2 border-transparent flex items-center gap-2">
                <i class="fa-solid fa-users-gear"></i> Identitas
            </button>
            <button onclick="window.navTo('master')" id="nav-master" class="nav-btn py-3 px-4 font-medium text-sm text-slate-600 hover:text-kemensos-navy border-b-2 border-transparent flex items-center gap-2">
                <i class="fa-solid fa-sliders"></i> Master & Kop
            </button>
            <button onclick="window.navTo('backup')" id="nav-backup" class="nav-btn py-3 px-4 font-medium text-sm text-slate-600 hover:text-kemensos-navy border-b-2 border-transparent flex items-center gap-2">
                <i class="fa-solid fa-database"></i> Backup & Export
            </button>
        </div>
    </nav>

    <main class="max-w-7xl mx-auto px-3 sm:px-6 py-4 md:py-6 flex-1 w-full">

        <section id="view-dashboard" class="view-page space-y-6">
            <div id="identitas-warning-banner" class="hidden bg-amber-50 border-l-4 border-amber-500 p-4 rounded-lg shadow-sm">
                <div class="flex items-start">
                    <i class="fa-solid fa-triangle-exclamation text-amber-600 text-xl mr-3 mt-0.5"></i>
                    <div>
                        <h3 class="text-sm font-semibold text-amber-800">Identitas Pendamping Belum Lengkap</h3>
                        <p class="text-xs text-amber-700 mt-1">Harap melengkapi Nama, NIP, Kelurahan, Kecamatan, dan Wilayah tugas Anda agar laporan PDF tercetak dengan benar.</p>
                        <button onclick="window.navTo('identitas')" class="mt-2 text-xs bg-kemensos-navy text-white px-3 py-1 rounded font-medium hover:bg-blue-950 shadow-sm">Lengkapi Identitas Sekarang</button>
                    </div>
                </div>
            </div>

            <div class="bg-gradient-to-r from-kemensos-navy via-blue-900 to-kemensos-navyDark rounded-2xl p-6 text-white shadow-md relative overflow-hidden border-l-4 border-kemensos-gold">
                <div class="absolute right-0 top-0 bottom-0 opacity-10 flex items-center pr-10 pointer-events-none">
                    <i class="fa-solid fa-clipboard-list text-9xl text-kemensos-gold"></i>
                </div>
                <div class="relative z-10">
                    <span class="bg-kemensos-gold text-kemensos-navy text-xs font-extrabold px-3 py-1 rounded-full shadow-sm">KEMENTERIAN SOSIAL RI</span>
                    <h2 class="text-xl md:text-2xl font-bold mt-2" id="dash-greeting">Selamat Datang, Pendamping PKH</h2>
                    <p class="text-xs md:text-sm text-slate-200 mt-1" id="dash-subtext">Kelola dan rekapitulasi laporan harian Anda dengan mudah dan terstruktur.</p>
                    
                    <div class="mt-5 flex flex-wrap gap-2">
                        <button onclick="window.navTo('tambah')" class="bg-kemensos-gold hover:bg-kemensos-goldHover text-kemensos-navy font-bold px-4 py-2 rounded-xl text-xs md:text-sm shadow flex items-center gap-2 transition transform active:scale-95">
                            <i class="fa-solid fa-plus-circle text-kemensos-navy"></i> Buat Laporan Baru
                        </button>
                        <button onclick="window.navTo('rekap')" class="bg-white/10 hover:bg-white/20 text-white font-medium px-4 py-2 rounded-xl text-xs md:text-sm border border-slate-300/30 flex items-center gap-2 transition">
                            <i class="fa-solid fa-file-pdf text-amber-300"></i> Rekap & Cetak PDF
                        </button>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4">
                <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-semibold uppercase text-slate-500 tracking-wider">Hari Ini</span>
                        <div class="w-8 h-8 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center">
                            <i class="fa-solid fa-calendar-day"></i>
                        </div>
                    </div>
                    <div class="text-2xl font-bold text-slate-800 mt-2" id="stat-today">0</div>
                    <p class="text-[11px] text-slate-500 mt-1">Laporan tersimpan hari ini</p>
                </div>

                <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-semibold uppercase text-slate-500 tracking-wider">Bulan Ini</span>
                        <div class="w-8 h-8 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center">
                            <i class="fa-solid fa-calendar-week"></i>
                        </div>
                    </div>
                    <div class="text-2xl font-bold text-slate-800 mt-2" id="stat-month">0</div>
                    <p class="text-[11px] text-slate-500 mt-1">Total kegiatan bulan aktif</p>
                </div>

                <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-semibold uppercase text-slate-500 tracking-wider">Tahun Ini</span>
                        <div class="w-8 h-8 rounded-lg bg-indigo-100 text-indigo-700 flex items-center justify-center">
                            <i class="fa-solid fa-calendar"></i>
                        </div>
                    </div>
                    <div class="text-2xl font-bold text-slate-800 mt-2" id="stat-year">0</div>
                    <p class="text-[11px] text-slate-500 mt-1">Total kegiatan akumulasi</p>
                </div>

                <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-semibold uppercase text-slate-500 tracking-wider">Foto Dok.</span>
                        <div class="w-8 h-8 rounded-lg bg-purple-100 text-purple-700 flex items-center justify-center">
                            <i class="fa-solid fa-camera"></i>
                        </div>
                    </div>
                    <div class="text-2xl font-bold text-slate-800 mt-2" id="stat-photos">0</div>
                    <p class="text-[11px] text-slate-500 mt-1">Total file foto terlampir</p>
                </div>
            </div>

            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
                <div class="flex justify-between items-center mb-4">
                    <h3 class="font-bold text-slate-800 text-base flex items-center gap-2">
                        <i class="fa-solid fa-chart-bar text-kemensos-navy"></i> Distribusi Kegiatan RHK (1 - 9)
                    </h3>
                    <span class="text-xs text-slate-500">Master RHK 1 - 9</span>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3" id="rhk-stat-grid"></div>
            </div>

            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
                <div class="flex justify-between items-center mb-4">
                    <h3 class="font-bold text-slate-800 text-base flex items-center gap-2">
                        <i class="fa-solid fa-clock-rotate-left text-kemensos-navy"></i> Laporan Terbaru
                    </h3>
                    <button onclick="window.navTo('data')" class="text-xs text-kemensos-navy font-semibold hover:underline">Lihat Semua <i class="fa-solid fa-arrow-right"></i></button>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-xs text-left text-slate-600">
                        <thead class="bg-slate-50 text-slate-700 uppercase font-semibold text-[11px] border-b border-slate-200">
                            <tr>
                                <th class="p-3">Tanggal</th>
                                <th class="p-3">RHK</th>
                                <th class="p-3">Pilihan Laporan</th>
                                <th class="p-3">Lokasi</th>
                                <th class="p-3 text-center">Foto</th>
                                <th class="p-3 text-center">Aksi</th>
                            </tr>
                        </thead>
                        <tbody id="dashboard-recent-table" class="divide-y divide-slate-100"></tbody>
                    </table>
                </div>
            </div>
        </section>

        <section id="view-identitas" class="view-page hidden space-y-6">
            <!-- Accounts / Profiles Selector Section -->
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 md:p-6 space-y-4">
                <div class="flex flex-col sm:flex-row justify-between sm:items-center gap-2 border-b border-slate-200 pb-3">
                    <div>
                        <h2 class="text-lg md:text-xl font-bold text-slate-800 flex items-center gap-2">
                            <i class="fa-solid fa-users text-kemensos-navy"></i> Kelola Profil & Akun Pendamping
                        </h2>
                        <p class="text-xs text-slate-500 mt-0.5">Anda dapat menambahkan dan memilih akun Pendamping PKH yang aktif digunakan.</p>
                    </div>
                    <button onclick="window.createNewProfileForm()" class="bg-kemensos-navy hover:bg-blue-950 text-white text-xs font-semibold px-3.5 py-2 rounded-xl shadow flex items-center gap-1.5 self-start sm:self-auto">
                        <i class="fa-solid fa-user-plus text-kemensos-gold"></i> + Tambah Akun Baru
                    </button>
                </div>

                <!-- Cards Grid for Saved Profiles -->
                <div id="profiles-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4"></div>
            </div>

            <!-- Profile Form Editor -->
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 md:p-6">
                <div class="border-b border-slate-200 pb-4 mb-5 flex justify-between items-center">
                    <div>
                        <h2 class="text-base md:text-lg font-bold text-slate-800 flex items-center gap-2" id="profile-form-title">
                            <i class="fa-solid fa-user-pen text-kemensos-navy"></i> Form Identitas Pendamping
                        </h2>
                        <p class="text-xs text-slate-500 mt-0.5">Isi data identitas pendamping & tanda tangan digital untuk dicetak di PDF.</p>
                    </div>
                    <span class="bg-blue-50 text-kemensos-navy text-xs font-bold px-2.5 py-1 rounded border border-blue-200">Profil Pendamping</span>
                </div>

                <form id="form-identitas" onsubmit="window.saveIdentitas(event)" class="space-y-6">
                    <input type="hidden" id="profile-edit-id" value="">

                    <div>
                        <h3 class="text-sm font-bold text-slate-700 uppercase tracking-wider mb-3 border-b border-slate-100 pb-1 flex items-center gap-2">
                            <i class="fa-solid fa-user text-kemensos-gold"></i> Data Diri & Wilayah Tugas
                        </h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-medium text-slate-700 mb-1">Nama Lengkap Pendamping <span class="text-rose-500">*</span></label>
                                <input type="text" id="id_nama" required placeholder="Contoh: AHMAD FAUZI, S.Sos." class="w-full text-sm p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-kemensos-navy outline-none">
                            </div>

                            <div>
                                <label class="block text-xs font-medium text-slate-700 mb-1">NIP <span class="text-rose-500">*</span></label>
                                <input type="text" id="id_nip" required placeholder="Contoh: 199001012022011001" class="w-full text-sm p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-kemensos-navy outline-none">
                            </div>

                            <div>
                                <label class="block text-xs font-medium text-slate-700 mb-1">Kelurahan / Desa Wilayah Tugas <span class="text-rose-500">*</span></label>
                                <input type="text" id="id_kelurahan" required placeholder="Contoh: Kelurahan Tanjung Baru" class="w-full text-sm p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-kemensos-navy outline-none">
                            </div>

                            <div>
                                <label class="block text-xs font-medium text-slate-700 mb-1">Kecamatan Wilayah Tugas <span class="text-rose-500">*</span></label>
                                <input type="text" id="id_kecamatan" required placeholder="Contoh: Kedamaian" class="w-full text-sm p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-kemensos-navy outline-none">
                            </div>

                            <div>
                                <label class="block text-xs font-medium text-slate-700 mb-1">Kabupaten / Kota <span class="text-rose-500">*</span></label>
                                <input type="text" id="id_kabupaten" required placeholder="Contoh: Kota Bandar Lampung" class="w-full text-sm p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-kemensos-navy outline-none">
                            </div>

                            <div>
                                <label class="block text-xs font-medium text-slate-700 mb-1">Provinsi <span class="text-rose-500">*</span></label>
                                <input type="text" id="id_provinsi" required placeholder="Contoh: Lampung" class="w-full text-sm p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-kemensos-navy outline-none">
                            </div>

                            <div>
                                <label class="block text-xs font-medium text-slate-700 mb-1">Periode Default Laporan</label>
                                <input type="text" id="id_periode" placeholder="Contoh: Bulanan / Semester 1" class="w-full text-sm p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-kemensos-navy outline-none">
                            </div>

                            <div>
                                <label class="block text-xs font-medium text-slate-700 mb-1">Tahun Laporan</label>
                                <input type="number" id="id_tahun" value="2026" class="w-full text-sm p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-kemensos-navy outline-none">
                            </div>
                        </div>
                    </div>

                    <!-- Digital Signature Upload Section -->
                    <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-3">
                        <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wider flex items-center gap-2 border-b border-slate-200 pb-2">
                            <i class="fa-solid fa-signature text-kemensos-gold"></i> Unggah Tanda Tangan Digital (TTD)
                        </h3>

                        <div class="flex flex-col sm:flex-row items-center gap-4">
                            <div id="ttd-preview-box" class="w-36 h-20 border border-slate-300 rounded-lg flex items-center justify-center bg-white overflow-hidden shrink-0 shadow-sm relative">
                                <img id="ttd-img" src="" class="w-full h-full object-contain hidden" alt="TTD Digital">
                                <span id="ttd-placeholder" class="text-[11px] text-slate-400 font-medium text-center px-1">Belum Ada TTD</span>
                            </div>

                            <div class="space-y-1 text-center sm:text-left flex-1">
                                <input type="file" id="id_ttd_input" accept="image/png,image/jpeg,image/jpg" class="hidden" onchange="window.handleTTDSelect(event)">
                                <div class="flex flex-wrap gap-2 justify-center sm:justify-start">
                                    <button type="button" onclick="document.getElementById('id_ttd_input').click()" class="bg-kemensos-navy hover:bg-blue-950 text-white text-xs px-3.5 py-1.5 rounded-lg font-medium transition flex items-center gap-1.5">
                                        <i class="fa-solid fa-upload text-kemensos-gold"></i> Unggah TTD (PNG/JPG)
                                    </button>
                                    <button type="button" onclick="window.removeTTDImage()" id="btn-remove-ttd" class="bg-rose-100 text-rose-700 text-xs px-3 py-1.5 rounded-lg hover:bg-rose-200 font-medium transition hidden flex items-center gap-1">
                                        <i class="fa-solid fa-trash"></i> Hapus TTD
                                    </button>
                                </div>
                                <p class="text-[11px] text-slate-500">Format PNG transparansi direkomendasikan. TTD akan tercetak otomatis di atas Nama & NIP pada PDF.</p>
                            </div>
                        </div>
                    </div>

                    <div class="flex justify-end pt-4 border-t border-slate-100">
                        <button type="submit" class="bg-kemensos-navy hover:bg-blue-950 text-white font-semibold px-6 py-2.5 rounded-xl text-sm shadow transition flex items-center gap-2">
                            <i class="fa-solid fa-floppy-disk text-kemensos-gold"></i> Simpan Profil Pendamping
                        </button>
                    </div>
                </form>
            </div>
        </section>

        <section id="view-master" class="view-page hidden space-y-6">
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 md:p-6">
                <div class="border-b border-slate-200 pb-4 mb-5">
                    <h2 class="text-lg md:text-xl font-bold text-slate-800 flex items-center gap-2">
                        <i class="fa-solid fa-sliders text-kemensos-navy"></i> Pengaturan Master & Kop Surat PDF
                    </h2>
                    <p class="text-xs text-slate-500 mt-0.5">Atur Kop Surat instansi, Logo Instansi, dan kustomisasi teks narasi template laporan per jenis RHK.</p>
                </div>

                <!-- Kop Surat Form -->
                <form id="form-kop-master" onsubmit="window.saveKopSettings(event)" class="space-y-4 bg-slate-50 p-4 rounded-xl border border-slate-200 mb-6">
                    <h3 class="text-sm font-bold text-slate-800 uppercase tracking-wider flex items-center gap-2 border-b border-slate-200 pb-2">
                        <i class="fa-solid fa-heading text-kemensos-gold"></i> Pengaturan Kop Surat Laporan PDF
                    </h3>

                    <div class="bg-white p-3.5 rounded-xl border border-slate-200">
                        <label class="block text-xs font-bold text-slate-700 mb-1">Logo Instansi (Tampil di Kop Surat PDF)</label>
                        <div class="flex flex-col sm:flex-row items-center gap-4 mt-2">
                            <div id="kop-logo-preview-box" class="w-16 h-16 border border-slate-300 rounded-lg flex items-center justify-center bg-slate-100 overflow-hidden shrink-0">
                                <img id="kop-logo-img" src="" class="w-full h-full object-contain hidden" alt="Logo Kop">
                                <i id="kop-logo-placeholder" class="fa-solid fa-building-columns text-slate-400 text-2xl"></i>
                            </div>
                            <div class="space-y-1 text-center sm:text-left flex-1">
                                <input type="file" id="kop_logo_input" accept="image/png,image/jpeg,image/jpg" class="hidden" onchange="window.handleLogoSelect(event)">
                                <div class="flex flex-wrap gap-2 justify-center sm:justify-start">
                                    <button type="button" onclick="document.getElementById('kop_logo_input').click()" class="bg-kemensos-navy hover:bg-blue-950 text-white text-xs px-3.5 py-1.5 rounded-lg font-medium transition flex items-center gap-1.5">
                                        <i class="fa-solid fa-upload text-kemensos-gold"></i> Unggah Logo Instansi
                                    </button>
                                    <button type="button" onclick="window.removeKopLogo()" id="btn-remove-logo" class="bg-rose-100 text-rose-700 text-xs px-3 py-1.5 rounded-lg hover:bg-rose-200 font-medium transition hidden flex items-center gap-1">

        async function runAIGenerateNarrative() {
            const userNotes = document.getElementById('ai-user-prompt').value.trim();
            const rhkId = document.getElementById('form-rhk-select').value;
            const pilihanLaporan = document.getElementById('form-pilihan-laporan').value;
            const rhkMaster = MASTER_RHK.find(r => r.id === parseInt(rhkId, 10));

            if (!userNotes) {
                showToast('Harap isi instruksi atau poin singkat kegiatan!', 'error');
                return;
            }

            const loadingEl = document.getElementById('ai-loading-indicator');
            const runBtn = document.getElementById('btn-run-ai');
            loadingEl.classList.remove('hidden');
            runBtn.disabled = true;

            const systemPrompt = "Anda adalah Asisten AI Profesional Pendamping Program Keluarga Harapan (PKH) Kementerian Sosial Republik Indonesia. Tugas Anda menyusun teks uraian realisasi kegiatan, hasil yang dicapai, serta simpulan dan saran resmi laporan harian PKH yang baku, akurat, dan formal.";
            const userQuery = `Buatkan teks laporan harian PKH Kemensos RI untuk:
- RHK ${rhkId}: ${rhkMaster ? rhkMaster.desc : ''}
- Pilihan Laporan: ${pilihanLaporan}
- Poin Singkat Lapangan Pendamping: "${userNotes}"

Susun output JSON dengan field berikut:
1. "uraian": Uraian/realisasi kegiatan yang lengkap, formal, dan mencerminkan pelaksanaan di lapangan.
2. "hasil_dicapai": Uraian capaian hasil yang konkret dan jelas.
3. "simpulan_saran": Kesimpulan kegiatan dan saran tindak lanjut rekomendasi perbaikan.`;

            try {
                const aiResult = await callGeminiAPI(userQuery, systemPrompt);
                if (aiResult) {
                    if (aiResult.uraian) document.getElementById('form-uraian').value = aiResult.uraian;
                    if (aiResult.hasil_dicapai) document.getElementById('form-hasil-dicapai').value = aiResult.hasil_dicapai;
                    if (aiResult.simpulan_saran) document.getElementById('form-simpulan-saran').value = aiResult.simpulan_saran;

                    closeModal('modal-ai-assistant');
                    showToast('Uraian, Hasil, serta Simpulan & Saran berhasil disusun oleh AI!');
                }
            } catch (err) {
                console.error("AI Generation error:", err);
                showToast('Terjadi kesalahan saat memproses AI. Silakan coba lagi.', 'error');
            } finally {
                loadingEl.classList.add('hidden');
                runBtn.disabled = false;
            }
        }
        window.runAIGenerateNarrative = runAIGenerateNarrative;

        async function runAIGenerateMasterNarrative() {
            const rhkId = document.getElementById('master-rhk-select').value;
            const optVal = document.getElementById('master-pilihan-select').value;
            const userNotes = document.getElementById('ai-master-user-prompt').value.trim();

            if (!rhkId || !optVal) {
                showToast('Pilih RHK dan Pilihan Laporan terlebih dahulu!', 'error');
                return;
            }

            const loadingEl = document.getElementById('ai-master-loading-indicator');
            const runBtn = document.getElementById('btn-run-master-ai');
            loadingEl.classList.remove('hidden');
            runBtn.disabled = true;

            const rhkMaster = MASTER_RHK.find(r => r.id === parseInt(rhkId, 10));
